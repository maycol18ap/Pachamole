# Puerto HTTP de Express. El valor por defecto es 3000.
PORT=3000

# PostgreSQL local descartable. Sustituye estos valores ficticios.
# Express y Prisma Client
DATABASE_URL="postgresql://pachamole_local:clave_ficticia@127.0.0.1:5432/pachamole_dev?schema=pachamole"
# Prisma Migrate. En Supabase usa conexión directa o pooler de sesión.
DIRECT_URL="postgresql://pachamole_local:clave_ficticia@127.0.0.1:5432/pachamole_dev?schema=pachamole"
